<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- A separate alpha test item. CA_Wings is present only on the Caelavi
       wing records, so vanilla body-part checks prevent Human wear. The Belt
       layer follows Core's shield-belt pattern: an icon without a pawn overlay. -->
  <ThingDef ParentName="ArmorMachineableBase">
    <defName>CA_WingGuardAlpha</defName>
    <label>temporary wing guards</label>
    <description>A pair of simple plates strapped around a Caelavi's wings. This alpha test item protects the wings and blocks the flight benefit while worn.</description>
    <graphicData>
      <texPath>Caelavi/Items/WingGuardAlpha</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Industrial</techLevel>
    <thingCategories>
      <li>ApparelUtility</li>
    </thingCategories>
    <costList>
      <Steel>25</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <MarketValue>110</MarketValue>
      <WorkToMake>6000</WorkToMake>
      <Mass>2</Mass>
      <Flammability>0.4</Flammability>
      <ArmorRating_Sharp>0.45</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.20</ArmorRating_Blunt>
      <ArmorRating_Heat>0.10</ArmorRating_Heat>
      <EquipDelay>3</EquipDelay>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>Machining</researchPrerequisite>
      <useIngredientsForColor>false</useIngredientsForColor>
    </recipeMaker>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <bodyPartGroups>
        <li>CA_Wings</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <wearPerDay>0</wearPerDay>
    </apparel>
  </ThingDef>
</Defs>
